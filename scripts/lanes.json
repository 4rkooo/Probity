{
  "base": "person2/trueframe",
  "frozen": [
    "pyproject.toml",
    "uv.lock",
    ".gitattributes",
    "config/**",
    "contracts/**",
    "fixtures/schema/**",
    "fixtures/demo/**",
    "fixtures/synthetic/**",
    "src/probity/domain/**",
    "src/probity/ports.py",
    "src/probity/reconstruction/types.py",
    "src/probity/reconstruction/__init__.py",
    "src/probity/reconstruction/decisions.py",
