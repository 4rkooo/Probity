  "lanes": {
    "b": {
      "title": "AKAZE/RANSAC alignment, one ECC fallback, bounded color fit (kickoff steps 4-5)",
      "allow": [
        "src/probity/reconstruction/align.py",
        "src/probity/reconstruction/color.py",
        "tests/unit/reconstruction/lane_b/**",
        "notes/lane-b.md",
        "notes/lane-b-requests.md"
      ]
    },
    "c": {
      "title": "Donor ranking and 8x8 winner-take-all tile fusion (kickoff step 6)",
      "allow": [
        "src/probity/reconstruction/fuse.py",
        "tests/unit/reconstruction/lane_c/**",
        "notes/lane-c.md",
        "notes/lane-c-requests.md"
      ]
    },
    "d": {
      "title": "Provenance writer/validator and integrity-v1",
      "allow": [
        "src/probity/reconstruction/provenance.py",
        "src/probity/reconstruction/integrity.py",
        "tests/unit/reconstruction/lane_d/**",
        "notes/lane-d.md",
        "notes/lane-d-requests.md"
      ]
    },
    "e": {
      "title": "Real-ESRGAN baseline isolation and evaluation metrics (kickoff step 9)",
      "allow": [
        "src/probity/reconstruction/baseline.py",
        "src/probity/eval/metrics.py",
        "tests/unit/reconstruction/lane_e/**",
        "notes/lane-e.md",
        "notes/lane-e-requests.md"
      ]
    },
    "integrator": {
      "title": "INTEGRATOR (sequential, after B-E merge): trueframe.py, revert-only validation pass, golden regeneration",
      "allow": [
        "src/probity/reconstruction/trueframe.py",
        "src/probity/reconstruction/validate.py",
        "src/probity/eval/handbuilt_runs.py",
        "tests/integration/test_trueframe.py",
        "tests/unit/reconstruction/test_golden_runs.py",
        "tests/unit/reconstruction/integrator/**",
        "NOTES-person2.md",
        "notes/**"
      ],
      "frozen_exempt": [
        "fixtures/synthetic/*/reconstructions/**",
        "fixtures/demo/detections/**",
        "fixtures/demo/tracks/**",
        "fixtures/demo/reconstructions/**",
        "fixtures/demo/frames/**",
        "scripts/golden_hashes.json"
      ]
    },
    "f": {
      "title": "YOLO/ByteTrack live and fixture adapters (only after the integrator is green)",
      "allow": [
        "src/probity/adapters/live/yolo.py",
        "src/probity/adapters/fixture/yolo.py",
        "tests/contract/test_detector_tracker.py",
        "tests/unit/reconstruction/lane_f/**",
        "notes/lane-f.md",
        "notes/lane-f-requests.md"
      ]
