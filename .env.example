# Names only. Never commit real values.

# AUTO | LIVE | FIXTURE. AUTO starts with health checks and falls back to verified fixtures.
PROBITY_MODE=AUTO
PROBITY_DATA_DIR=./data
PROBITY_DATABASE_URL=sqlite:///./data/cases.db
PROBITY_POLICY_PATH=./config/policy.demo.yaml
PROBITY_FIXTURE_MANIFEST=./fixtures/demo/manifest.json
PROBITY_API_HOST=127.0.0.1
PROBITY_API_PORT=8000
PROBITY_API_BASE=http://127.0.0.1:8000
PROBITY_WORKER_ID=
PROBITY_LEASE_SECONDS=30
PROBITY_LOG_LEVEL=INFO

# When true, fixture Cosmos synthesizes descriptions for non-catalog uploads (demo only).
PROBITY_SYNTHETIC_DESCRIPTIONS=false

# Sponsor adapters. Prefer `source scripts/workshop_env.sh` on Builders Challenge VMs
# (maps /config/<team>.config → these names). No endpoint or credential is hard-coded in source.
PROBITY_VAST_ENABLED=false
PROBITY_VAST_ENDPOINT=
PROBITY_VAST_TOKEN=
PROBITY_COSMOS_ENABLED=false
PROBITY_COSMOS_ENDPOINT=
PROBITY_COSMOS_EMBED_ENDPOINT=
PROBITY_COSMOS_TOKEN=
PROBITY_COSMOS_MODEL_ID=
PROBITY_COSMOS_EMBED_MODEL_ID=
PROBITY_WANDB_ENABLED=false
PROBITY_WANDB_API_KEY=
PROBITY_YOLO_ENABLED=false
PROBITY_YOLO_ENDPOINT=
